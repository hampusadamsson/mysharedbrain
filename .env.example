# Vault location. One note = one .md file; folders = real folders.
# .brain/ inside holds the audit log, capture queue, job runs and saved settings.
VAULT_DIR=./vault

# Seed config file (only ever read). Defaults to ./brain.yaml; see
# brain.example.yaml for the shipped defaults. Saved settings live in the vault
# database and take precedence over this file.
# BRAIN_CONFIG=./brain.yaml

# Any config value, with BRAIN__ + __ nesting. The environment wins over both
# the seed file and saved settings, so this is where a container injects secrets.
# BRAIN__AGENT__MODEL=openai:gpt-4o
# BRAIN__AGENT__API_KEY=sk-…
# BRAIN__SCHEDULER__ENABLED=true

# Log level for the API and the scheduler (default INFO).
# BRAIN_LOG_LEVEL=DEBUG
